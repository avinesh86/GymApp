# Django
DJANGO_SETTINGS_MODULE=fitops.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production example (see DEPLOY_DOMAIN.md):
#   ALLOWED_HOSTS=fitops.northernarena.co.nz
# Hostnames only — no scheme, no port.
#
# CSRF_TRUSTED_ORIGINS is required by Django 4.x for any unsafe request over
# HTTPS, including the /platform-admin/ login. Scheme included, comma separated.
#   CSRF_TRUSTED_ORIGINS=https://fitops.northernarena.co.nz
CSRF_TRUSTED_ORIGINS=
#
# CORS_ALLOWED_ORIGINS only matters if the SPA is ever served from a different
# origin than the API. In the Docker deployment Django serves both (SPAView
# catch-all in fitops/urls.py), so same-origin requests never hit CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
MYSQL_DATABASE=fitops
MYSQL_USER=fitops
MYSQL_PASSWORD=fitops_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email
# Where outbound SMTP is blocked — every DigitalOcean droplet — send over
# HTTPS through Resend instead:
#   EMAIL_BACKEND=apps.core.email_backends.ResendEmailBackend
#   RESEND_API_KEY=re_...
#   DEFAULT_FROM_EMAIL=FitOps <noreply@fitops.example.nz>
# The from-address must be on a domain verified in Resend. Each gym's own
# address becomes the reply-to, set under Settings -> Notifications.
RESEND_API_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@fitops.io

# WhatsApp Business Cloud API
META_APP_SECRET=your-meta-app-secret

# Encryption key for sensitive fields (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# AWS S3 (prod only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-2

# Sentry (prod only)
SENTRY_DSN=

# Stripe (backend)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe (frontend — put in frontend/.env)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
